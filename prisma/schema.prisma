// Reference schema (same tables the API auto-creates via @vercel/postgres).
// Optional: `npx prisma db push` if you prefer Prisma-managed migrations.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  category String
  price    Int
  mrp      Int
  rating   Decimal @db.Decimal(2, 1)
  image    String
  featured Boolean @default(false)
  @@map("products")
}
model CartItem {
  uid       String
  productId Int @map("product_id")
  qty       Int
  @@id([uid, productId])
  @@map("cart")
}
model WishlistItem {
  uid       String
  productId Int @map("product_id")
  @@id([uid, productId])
  @@map("wishlist")
}
